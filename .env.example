# API Configuration (Supports any OpenAI-compatible API)
OPENAI_API_KEY=your_api_key_here

# Optional: Set a custom base URL if using a custom endpoint or another model provider (like DeepSeek, Ollama, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Specify the model name
# OPENAI_MODEL=gpt-4o

# --- Context window for compaction ---
# The agent compacts conversation history once the prompt nears this token budget.
# Set to your model's real context window. Common values:
#   deepseek-chat ........ 64000
#   gpt-4o / gpt-4.1 ..... 128000
#   claude / gemini ...... 200000
# MODEL_CONTEXT_WINDOW=64000

# Optional: fraction of the window at which compaction kicks in (default 0.8).
# MODEL_CONTEXT_BUDGET=0.8

# --- Cost tracking (tokens are always counted; prices estimate USD cost) ---
# Per-1M-token prices. Defaults follow DeepSeek-chat cache-miss pricing.
# PRICE_INPUT_PER_1M=0.27
# PRICE_OUTPUT_PER_1M=1.10
# COST_CURRENCY=USD

# --- Credential vault (production hardening) ---
# Master key used to encrypt stored device credentials (AES-GCM). Leave unset on
# first run and one will be generated and saved to data/vault/.master_key.
# For production, set a stable value here (and rotate it carefully -- rotating
# invalidates all stored credentials).
# VAULT_MASTER_KEY=replace-with-a-long-random-string

# --- Backward compatibility with DeepSeek ---
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Web + MCP startup ---
# WEB_HOST=0.0.0.0
# WEB_PORT=8000
# MCP_HOST=0.0.0.0
# MCP_PORT=8787
# Set to 0 to run only the web server (for example when using stdio MCP).
# SSHELPER_START_MCP=1
